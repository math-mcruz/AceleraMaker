MAPSET1  KIKMSD MODE=INOUT,CTRL=(FREEKB,FRSET)
MAP1     KIKMDI SIZE=(24,80)
         KIKMDF POS=(02,17),LENGTH=30,INITIAL='**********************'
         KIKMDF POS=(03,17),LENGTH=30,INITIAL='*CONSULTA DE CLIENTES*'
         KIKMDF POS=(04,17),LENGTH=30,INITIAL='**********************'
         KIKMDF POS=(07,17),LENGTH=15,INITIAL='CODIGO CLIENTE:'
CODCLI   KIKMDF POS=(07,33),LENGTH=06,ATTRB=(UNPROT,NUM,IC)
         KIKMDF POS=(09,17),LENGTH=15,INITIAL='NOME..........:'
NAME     KIKMDF POS=(09,33),LENGTH=30,ATTRB=UNPROT
         KIKMDF POS=(11,17),LENGTH=15,INITIAL='TELEFONE......:'
FONE     KIKMDF POS=(11,33),LENGTH=15,ATTRB=UNPROT
         KIKMDF POS=(13,17),LENGTH=15,INITIAL='CIDADE........:'
CITY     KIKMDF POS=(13,33),LENGTH=20,ATTRB=UNPROT
         KIKMDF POS=(15,17),LENGTH=15,INITIAL='MENSAGEM......:'
MSG      KIKMDF POS=(15,33),LENGTH=22
         KIKMDF POS=(18,17),LENGTH=08,INITIAL='PF3=SAIR'
         KIKMDF POS=(19,17),LENGTH=13,INITIAL='PF5=CONSULTAR'
         KIKMDF POS=(20,17),LENGTH=10,INITIAL='PF6=SALVAR'
         KIKMSD TYPE=FINAL
         END
